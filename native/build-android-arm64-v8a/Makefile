.PHONY : libenchantcrypto_src/secure/buffer.cpp.i

libenchantcrypto_src/secure/buffer.s: libenchantcrypto_src/secure/buffer.cpp.s
.PHONY : libenchantcrypto_src/secure/buffer.s

# target to generate assembly for a file
libenchantcrypto_src/secure/buffer.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/enchantcrypto_jni.dir/build.make CMakeFiles/enchantcrypto_jni.dir/libenchantcrypto_src/secure/buffer.cpp.s
.PHONY : libenchantcrypto_src/secure/buffer.cpp.s

